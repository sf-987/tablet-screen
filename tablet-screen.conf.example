# ~/.config/tablet-screen.conf — shell fragment; environment variables of the same names override.
# evdi heads (see evdi/README.md):
#TABLET_OUTPUTS="DVI-I-1-1 DVI-I-2-2"
# dummy plugs: leave TABLET_OUTPUTS unset (auto-detects connected outputs reporting 0mm x 0mm)

#TABLET_MODE=3840x2400          # mode set when the script first enables a head (desktop UI scale 200%)
#TABLET_VNC_SCALE=1/2           # x11vnc -scale; 1 = none; "1/2:nb" = no blending (faster, ragged cursor)
#TABLET_WAIT=20                 # x11vnc poll interval ms (5 = snappier, more CPU)
#TABLET_XDAMAGE=0               # 1 = poll only damaged regions (near-zero idle CPU; may lag under some compositors)
#TABLET_TOUCH=0                 # 1 = allow mouse/keyboard from the tablets
#TABLET_CURSOR=paint            # paint | shape
#TABLET_NAMES="YOUR_DEVICE_SN_#1=S9U YOUR_DEVICE_SN_#2=S8U"   # map tablet device serial numbers via USB serial -> label (udevadm info -q property -p /sys/class/net/<if> | grep ID_SERIAL_SHORT)
#TABLET_ALLOW=192.168.1.        # extra allowed client prefixes (comma-separated)
#TABLET_BASE_PORT=5900
